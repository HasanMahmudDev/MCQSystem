@page
@model MCQSystem.WebUI.Pages.Account.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<form method="post" class="needs-validation" novalidate>
    <div class="mb-4">
        <p class="eyebrow mb-1">Secure Access</p>
        <h1 class="h3 mb-1">Forgot Password</h1>
        <p class="text-muted mb-0">Get a reset link for your account.</p>
    </div>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }
    <div class="mb-4">
        <label class="form-label" asp-for="Input.Email"></label>
        <input class="form-control" asp-for="Input.Email" type="email" required />
        <span class="text-danger small" asp-validation-for="Input.Email"></span>
    </div>
    <button class="btn btn-primary w-100" type="submit"><i class="bi bi-envelope-arrow-up" aria-hidden="true"></i> Send Reset Link</button>
</form>

<p class="text-muted small mt-3 mb-0">Check your inbox and spam folder after submitting.</p>
<div class="auth-footer">Remembered it? <a asp-page="/Account/Login">Back to login</a></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
