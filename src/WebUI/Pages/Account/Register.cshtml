@page
@model MCQSystem.WebUI.Pages.Account.RegisterModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
}

<form method="post" class="needs-validation" novalidate>
    <div class="mb-4">
        <p class="eyebrow mb-1">Student Access</p>
        <h1 class="h3 mb-1">Register</h1>
        <p class="text-muted mb-0">Create a student account and start available exams.</p>
    </div>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="Input.FullName"></label>
        <input class="form-control" asp-for="Input.FullName" required />
        <span class="text-danger small" asp-validation-for="Input.FullName"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Input.Email"></label>
        <input class="form-control" asp-for="Input.Email" type="email" required />
        <span class="text-danger small" asp-validation-for="Input.Email"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Input.Password"></label>
        <input class="form-control" asp-for="Input.Password" type="password" minlength="8" required />
        <span class="text-danger small" asp-validation-for="Input.Password"></span>
    </div>
    <button class="btn btn-primary w-100" type="submit"><i class="bi bi-person-plus" aria-hidden="true"></i> Create Account</button>
</form>

<div class="auth-footer">Already have an account? <a asp-page="/Account/Login">Sign in</a></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
