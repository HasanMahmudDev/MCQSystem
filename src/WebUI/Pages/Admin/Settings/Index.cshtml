@page
@model MCQSystem.WebUI.Pages.Admin.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
}

<div class="page-heading">
    <div class="page-heading-copy">
        <span class="page-icon"><i class="bi bi-gear" aria-hidden="true"></i></span>
        <div>
            <p class="eyebrow mb-1">Configuration</p>
            <h1 class="h3 mb-1">Settings</h1>
            <p class="text-muted mb-0">Control registration and scoring defaults.</p>
        </div>
    </div>
</div>

<section class="row g-3">
    <div class="col-12 col-xl-7">
        <form method="post" asp-page-handler="Save" class="panel needs-validation" novalidate>
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title"><i class="bi bi-ui-checks-grid" aria-hidden="true"></i><span>System Settings</span></h2>
                    <p class="text-muted mb-0">Stored in the MongoDB Settings collection.</p>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.SiteName"></label>
                    <input class="form-control" asp-for="Input.SiteName" required />
                    <span class="text-danger small" asp-validation-for="Input.SiteName"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.SupportEmail"></label>
                    <input class="form-control" asp-for="Input.SupportEmail" type="email" required />
                    <span class="text-danger small" asp-validation-for="Input.SupportEmail"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.DefaultPassPercentage"></label>
                    <input class="form-control" asp-for="Input.DefaultPassPercentage" type="number" min="0" max="100" />
                </div>
                <div class="col-md-6 d-flex align-items-end gap-4">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.AllowRegistration" />
                        <label class="form-check-label" asp-for="Input.AllowRegistration"></label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.EnableNegativeMarking" />
                        <label class="form-check-label" asp-for="Input.EnableNegativeMarking"></label>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-primary" type="submit"><i class="bi bi-save" aria-hidden="true"></i> Save Settings</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
