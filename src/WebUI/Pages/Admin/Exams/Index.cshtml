@page
@model MCQSystem.WebUI.Pages.Admin.Exams.IndexModel
@{
    ViewData["Title"] = "Manage Exams";
}

<div class="page-heading">
    <div class="page-heading-copy">
        <span class="page-icon"><i class="bi bi-journal-check" aria-hidden="true"></i></span>
        <div>
            <p class="eyebrow mb-1">Exam Engine</p>
            <h1 class="h3 mb-1">Manage Exams</h1>
            <p class="text-muted mb-0">Create timed exams with pass marks, publishing windows, and random question delivery.</p>
        </div>
    </div>
</div>

<section class="row g-3">
    <div class="col-12 col-xl-4">
        <form method="post" asp-page-handler="Save" class="panel needs-validation" novalidate>
            <input type="hidden" asp-for="Input.Id" />
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title"><i class="bi bi-ui-checks-grid" aria-hidden="true"></i><span>@(string.IsNullOrWhiteSpace(Model.Input.Id) ? "Create Exam" : "Update Exam")</span></h2>
                    <p class="text-muted mb-0">Configure score and availability rules.</p>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Title"></label>
                <input class="form-control" asp-for="Input.Title" required />
                <span class="text-danger small" asp-validation-for="Input.Title"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.CategoryId"></label>
                <select class="form-select" asp-for="Input.CategoryId" required>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Description"></label>
                <textarea class="form-control" asp-for="Input.Description" rows="3"></textarea>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label" asp-for="Input.DurationMinutes"></label>
                    <input class="form-control" asp-for="Input.DurationMinutes" type="number" min="1" />
                </div>
                <div class="col-6">
                    <label class="form-label" asp-for="Input.NumberOfQuestions"></label>
                    <input class="form-control" asp-for="Input.NumberOfQuestions" type="number" min="1" />
                </div>
                <div class="col-6">
                    <label class="form-label" asp-for="Input.TotalMarks"></label>
                    <input class="form-control" asp-for="Input.TotalMarks" type="number" step="0.25" min="0" />
                </div>
                <div class="col-6">
                    <label class="form-label" asp-for="Input.PassMarks"></label>
                    <input class="form-control" asp-for="Input.PassMarks" type="number" step="0.25" min="0" />
                </div>
            </div>
            <div class="row g-2 mt-1">
                <div class="col-6">
                    <label class="form-label" asp-for="Input.StartsAtUtc"></label>
                    <input class="form-control" asp-for="Input.StartsAtUtc" type="datetime-local" />
                </div>
                <div class="col-6">
                    <label class="form-label" asp-for="Input.EndsAtUtc"></label>
                    <input class="form-control" asp-for="Input.EndsAtUtc" type="datetime-local" />
                </div>
            </div>
            <div class="form-check mt-3">
                <input class="form-check-input" asp-for="Input.IsPublished" />
                <label class="form-check-label" asp-for="Input.IsPublished"></label>
            </div>
            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="Input.RandomizeQuestions" />
                <label class="form-check-label" asp-for="Input.RandomizeQuestions"></label>
            </div>
            <button class="btn btn-primary w-100" type="submit"><i class="bi bi-save" aria-hidden="true"></i> Save Exam</button>
        </form>
    </div>
    <div class="col-12 col-xl-8">
        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title"><i class="bi bi-table" aria-hidden="true"></i><span>Exam List</span></h2>
                    <p class="text-muted mb-0">@Model.Items.Count exams found.</p>
                </div>
                <form method="get"><input class="form-control form-control-sm table-search" asp-for="Search" type="search" placeholder="Search exams" /></form>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Exam</th><th>Category</th><th>Duration</th><th>Pass</th><th>Status</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <p class="fw-semibold mb-0">@item.Title</p>
                                <p class="text-muted small mb-0">@item.NumberOfQuestions questions</p>
                            </td>
                            <td>@Model.CategoryName(item.CategoryId)</td>
                            <td>@item.DurationMinutes min</td>
                            <td>@item.PassMarks / @item.TotalMarks</td>
                            <td><span class="badge @(item.IsPublished ? "text-bg-success" : "text-bg-secondary")">@(item.IsPublished ? "Published" : "Draft")</span></td>
                            <td class="text-end">
                                <a class="btn btn-light btn-sm" asp-route-editId="@item.Id"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline" data-confirm="Delete this exam?">
                                    <button class="btn btn-light btn-sm" type="submit"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="(Model.PageNumber, Model.TotalPages, Model.Search, Model.Input.Id)" />
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
