@page
@model MCQSystem.WebUI.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="page-heading">
    <div class="page-heading-copy">
        <span class="page-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
        <div>
            <p class="eyebrow mb-1">Question Bank</p>
            <h1 class="h3 mb-1">Categories</h1>
            <p class="text-muted mb-0">Group exams and questions by subject area.</p>
        </div>
    </div>
</div>

<section class="row g-3">
    <div class="col-12 col-xl-4">
        <form method="post" asp-page-handler="Save" class="panel needs-validation" novalidate>
            <input type="hidden" asp-for="Input.Id" />
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title"><i class="bi bi-ui-checks-grid" aria-hidden="true"></i><span>@(string.IsNullOrWhiteSpace(Model.Input.Id) ? "Create Category" : "Update Category")</span></h2>
                    <p class="text-muted mb-0">Use the same adminHMD form style for maintenance screens.</p>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Name"></label>
                <input class="form-control" asp-for="Input.Name" required />
                <span class="text-danger small" asp-validation-for="Input.Name"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Description"></label>
                <textarea class="form-control" asp-for="Input.Description" rows="4"></textarea>
            </div>
            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="Input.IsActive" />
                <label class="form-check-label" asp-for="Input.IsActive"></label>
            </div>
            <button class="btn btn-primary w-100" type="submit"><i class="bi bi-save" aria-hidden="true"></i> Save Category</button>
        </form>
    </div>
    <div class="col-12 col-xl-8">
        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title"><i class="bi bi-table" aria-hidden="true"></i><span>Category List</span></h2>
                    <p class="text-muted mb-0">@Model.Items.Count categories found.</p>
                </div>
                <form method="get">
                    <input class="form-control form-control-sm table-search" asp-for="Search" type="search" placeholder="Search categories" />
                </form>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Name</th><th>Description</th><th>Status</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <p class="fw-semibold mb-0">@item.Name</p>
                                <p class="text-muted small mb-0">@item.Slug</p>
                            </td>
                            <td>@item.Description</td>
                            <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <a class="btn btn-light btn-sm" asp-route-editId="@item.Id"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline" data-confirm="Delete this category?">
                                    <button class="btn btn-light btn-sm" type="submit"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="(Model.PageNumber, Model.TotalPages, Model.Search, Model.Input.Id)" />
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
