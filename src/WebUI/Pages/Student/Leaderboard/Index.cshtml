@page
@model MCQSystem.WebUI.Pages.Student.Leaderboard.IndexModel
@{
    ViewData["Title"] = "Leaderboard";
}

<div class="page-heading">
    <div class="page-heading-copy">
        <span class="page-icon"><i class="bi bi-trophy" aria-hidden="true"></i></span>
        <div>
            <p class="eyebrow mb-1">Student</p>
            <h1 class="h3 mb-1">Leaderboard</h1>
            <p class="text-muted mb-0">Top scores for each published exam.</p>
        </div>
    </div>
</div>

<section class="panel mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="examId">Exam</label>
            <select class="form-select" id="examId" name="examId" asp-for="ExamId" asp-items="Model.ExamOptions"></select>
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary w-100" type="submit"><i class="bi bi-search" aria-hidden="true"></i> View Rankings</button>
        </div>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ExamId))
{
    <section class="panel">
        <div class="panel-header">
            <div>
                <h2 class="h5 mb-1 section-title"><i class="bi bi-trophy" aria-hidden="true"></i><span>Top Performers</span></h2>
                <p class="text-muted mb-0">@Model.Leaderboard.Count ranked submissions.</p>
            </div>
        </div>
        @if (Model.Leaderboard.Count == 0)
        {
            <p class="mb-0">No submissions yet for this exam.</p>
        }
        else
        {
            var rank = 1;
            @foreach (var result in Model.Leaderboard)
            {
                <div class="mini-stat">
                    <div>
                        <p class="fw-semibold mb-0">#@rank @result.UserName</p>
                        <p class="text-muted small mb-0">@result.ObtainedMarks / @result.TotalMarks marks</p>
                    </div>
                    <span class="badge text-bg-primary">@result.Percentage%</span>
                </div>
                rank++;
            }
        }
    </section>
}
