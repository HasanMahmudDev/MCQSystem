@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-heading">
    <div class="page-heading-copy">
        <span class="page-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
        <div>
            <p class="eyebrow mb-1">System</p>
            <h1 class="h3 mb-1">Error</h1>
            <p class="text-muted mb-0">@Model.Message</p>
        </div>
    </div>
</div>

<section class="panel">
    <p class="mb-0">Please return to your workspace and try again.</p>
</section>
